# --- Database (Neon Postgres) ---
# Get this from https://console.neon.tech → your project → Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth ---
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Vercel Blob (private attachments / proof of payment) ---
# Create a Blob store in the Vercel dashboard → Storage → Blob, then copy the token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# --- Cron protection ---
# Any long random string. Vercel Cron sends it as a Bearer token to /api/cron/*.
CRON_SECRET="replace-with-a-long-random-string"

# --- Public app URL (used in emails / links, Phase 2) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (Phase 2, OPTIONAL) ---
# Leave blank in development: the app auto-creates a free Ethereal test inbox
# and logs a preview URL so you can view sent invoices without any account.
# For real delivery, use ANY free SMTP provider (Gmail app password, Brevo,
# Mailtrap, Resend SMTP, ...):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="InvoiceBook <no-reply@yourdomain.com>"
